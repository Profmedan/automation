# OpenAI API
OPENAI_API_KEY=your_openai_key_here

# ElevenLabs API
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# Blogger OAuth2 (pour accès Google Drive)
BLOGGER_CLIENT_ID=your_blogger_client_id
BLOGGER_CLIENT_SECRET=your_blogger_client_secret

# LinkedIn API (voir SETUP-LINKEDIN-API.md)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

# Chemins
BLOGGER_OUTPUT_PATH=/Users/ph/.openclaw/workspace/blogger-automation
VIDEO_OUTPUT_PATH=/Users/ph/.openclaw/workspace/linkedin-videos
WORKSPACE_ROOT=/Users/ph/.openclaw/workspace
PENDING_ARTICLES_DIR=/Users/ph/.openclaw/workspace/pending-articles
BLOGGER_TOKEN_PATH=/Users/ph/.openclaw/workspace/blogger-automation/token.json
FFPROBE_PATH=ffprobe
